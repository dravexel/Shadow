# ShadowForge — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# TrueForge server URL (default for local mode)
TRUEFORGE_API_URL=http://localhost:8790

# TrueForge API key (leave empty for local SQLite mode)
TRUEFORGE_API_KEY=

# Primary agent ID (must be registered in TrueForge)
SHADOWFORGE_PRIMARY_AGENT=shadowforge-coder

# Fallback agent ID (must be registered in TrueForge)
SHADOWFORGE_FALLBACK_AGENT=shadowforge-fallback

# MCP server port (must match VS Code extension setting)
MCP_PORT=3001

# Context budget in tokens
CONTEXT_BUDGET_TOKENS=32000

# This is auto-generated at runtime — do not set manually
# SHADOWFORGE_MCP_TOKEN=
